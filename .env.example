# Azure App Registration credentials
MS_CLIENT_ID=your-client-id-here
MS_CLIENT_SECRET=your-client-secret-value-here
MS_TENANT_ID=common

# OAuth redirect (must match Azure App Registration)
MS_REDIRECT_URI=http://localhost:3333/auth/callback

# Optional: Override default scopes (space-separated)
# MS_SCOPES=offline_access User.Read Mail.Read Mail.ReadWrite Mail.Send Calendars.Read Calendars.ReadWrite

# Optional: Custom token storage path
# TOKEN_STORE_PATH=~/.outlook-mcp-tokens.json

# Set to true to use mock data instead of real API calls
# USE_TEST_MODE=true
